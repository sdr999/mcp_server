# --- Pluggable Tenancy Store (Phase 1) ---
# Supported options: 'sqlite' | 'mongodb' | 'memory' | 'json'
MCP_TENANCY_STORE=sqlite
MCP_TENANCY_DB=data/tenancy.db
MCP_TENANCY_DSN=mongodb://localhost:27017
MCP_TENANCY_DB_NAME=mcp_tenancy
MCP_TENANCY_SEED=true
MCP_DEFAULT_ORG=default

# --- RBAC Policy Engine & L1 Decision Cache (Phase 2 & 3) ---
MCP_RBAC_ENABLED=true
MCP_RBAC_CACHE_TTL_SEC=300
MCP_RBAC_CACHE_MAX_SIZE=1000
