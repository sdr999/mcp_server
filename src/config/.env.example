# agentic-mcp-server configuration — EXAMPLE / TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# The real `.env` is git-ignored (see .gitignore).

# --- Mongo ---
MONGO_DB_HOST=
MONGO_DB_PORT=27017
MONGO_DB_NAME=agent-db

# --- Tool source ---
# Default is 'auto': Azure IS the default/primary source (tried first). It only
# falls back to the local tools directory if Azure is missing/unreachable, so the
# server never crashes just because Azure is down.
# auto  : Azure by default, automatic local fallback on failure (default)
# azure : require Azure — fail fast if unavailable (no fallback)
# local : never touch Azure; serve only the local tools directory
MCP_TOOL_SOURCE=auto

# --- Azure File Share (tool distribution) ---
# Connection string contains AccountKey — treat as a secret.
# Required only for MCP_TOOL_SOURCE=azure; optional for auto; ignored for local.
AZURE_FILESTORE_CONNECTION_URL=
AZURE_FILESTORE_NAME=
TEMP_FILE_PATH="/path/to/temp_files"

# --- MCP server ---
MCP_URL="http://<host>:8000/sse"
MODEL_ID=4
EVAL_ENABLED=true
# Server bind + tool-sync cadence (optional; defaults shown)
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_POLL_INTERVAL_SEC=60
# Per-tool import timeout (seconds) — a slow/hanging tool import is skipped
MCP_TOOL_IMPORT_TIMEOUT_SEC=30
# Azure SDK log level. Defaults to WARNING to hide the very verbose per-request
# HTTP logs. Set to INFO/DEBUG only when debugging Azure File Share issues.
MCP_AZURE_LOG_LEVEL=WARNING
# Metrics: wrap tools to record per-call counters/latency (exposed at /metrics).
# Loader/registry gauges are always exported regardless of this flag.
MCP_METRICS=true
# Sandbox: run each tool call in a separate process (crash/hang/resource isolation).
# Opt-in; args/results must be JSON-serializable; Context/streaming tools unsupported.
MCP_SANDBOX_TOOLS=false
MCP_SANDBOX_TIMEOUT_SEC=30
# Optional POSIX resource limits for sandboxed tool subprocesses (ignored on Windows)
MCP_SANDBOX_MEM_MB=0
MCP_SANDBOX_CPU_SEC=0
# Admin API bearer token — enables /admin/*; leave blank to disable the admin API
MCP_ADMIN_TOKEN=
# Signed tools (supply-chain): only load files listed in a trusted manifest
MCP_REQUIRE_SIGNED_TOOLS=false
MCP_TOOL_MANIFEST=tools.manifest.json
# Optional HMAC key protecting the manifest itself (use with --sign)
MCP_TOOL_SIGNING_KEY=

# --- MCP inbound auth ---
# MCP_AUTH_TYPE: none | api_key | bearer_jwt   (MCP_AUTHENTICATION_FLAG=true is legacy → bearer_jwt)
MCP_AUTH_TYPE=none
MCP_AUTHENTICATION_FLAG=false
# api_key mode:
MCP_API_KEY_HEADER=Authorization
MCP_API_KEY_VALUE=
# bearer_jwt mode:
JWKS_URL=""
# Recommended hardening for bearer_jwt (see multiple_mcp_main.py):
#   MCP_JWT_ISSUER   — expected `iss` claim
#   MCP_JWT_AUDIENCE — expected `aud` claim (leave blank only if you accept any audience)
#   MCP_JWT_REQUIRED_SCOPES — comma-separated scopes required on the token
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_JWT_REQUIRED_SCOPES=

# --- SAP OAuth ---
SAP_OAUTH_TOKEN_URL=""
SAP_CLIENT_ID=""
SAP_CLIENT_SECRET=""

# --- Terraform ---
TERRAFORM_DIR=terraform\\agentic-ecs-fargate
TFVARS_PATH=terraform\\agentic-ecs-fargate\\terraform.tfvars

# --- Langfuse observability ---
secret_key=
public_key=
host=http://<host>:3000

# --- Email credentials ---
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_TENANT_ID=
SENDER_EMAIL=

# --- ServiceNow ---
SN_BASE_URL=
SN_USERNAME=
SN_PASSWORD=""
SN_POLLER_FILTER=""
SN_POLLER_MODE="poller+listener"

# --- Azure Service Bus ---
SB_CONNECTION_STR=""
SB_QUEUE_NAME=servicenow-input
ACK_TEMPLATE=Hi team — incident {number} is acknowledged by the AI agent. Details: {short_description}
VERIFY_TLS=False
POLL_INTERVAL_SEC=5
POLL_LOOKBACK_SEC=60

# --- RAG ---
RAG_AUTOREPLY=True
RAG_BACKEND=local
RAG_MIN_SIM=0.1
RAG_MODE=local

# --- Azure OpenAI (azure RAG mode) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ============================================================================
# src/main.py — plugin-based tool server & risk-gated tool onboarding
# (see docs/MCP_MAIN_SERVER.md and docs/MCP_TOOL_ONBOARDING.md)
# main.py has NO Azure/remote tool source; tools are local + onboarded over HTTP.
# ============================================================================

# --- Tool onboarding (POST /admin/tools/onboard) ---
# Master switch for the onboarding endpoints (403/503 when disabled).
MCP_TOOL_ONBOARD_ENABLED=true
# false => any submission needing a NEW dependency is held pending regardless
# of its risk score (tools with no new deps still onboard immediately).
MCP_TOOL_AUTOINSTALL_DEPS=true

# --- Dependency risk assessment ---
# Enable the PyPI metadata lookup + transitive-closure resolution. false runs
# fully offline (assesses only direct, declared/inferred deps).
MCP_TOOL_RISK_NETWORK_CHECK=true
MCP_TOOL_RISK_NETWORK_TIMEOUT_SEC=3
# JSON array files (paths relative to src/) of extra trusted / blocked package
# names, merged with the built-in defaults (PEP 503 normalized).
MCP_TOOL_DEPENDENCY_ALLOWLIST=
MCP_TOOL_DEPENDENCY_DENYLIST=

# --- Dependency install ---
MCP_TOOL_INSTALL_TIMEOUT_SEC=120
# true => pass `--only-binary :all:` to pip so it never runs a package's
# setup.py (arbitrary code) during install/resolution.
MCP_TOOL_INSTALL_ONLY_BINARY=false

# --- Onboarding audit trail ---
# Append-only JSON-lines log of onboard/approve/reject actions (path relative
# to src/). Note: one shared admin token => no per-actor identity is recorded.
MCP_TOOL_AUDIT_LOG=logs/onboarding_audit.log

# --- Tool import (shared with reload) ---
# A submitted/edited tool whose top-level import exceeds this is skipped so it
# can't freeze the server.
MCP_TOOL_IMPORT_TIMEOUT_SEC=30

# --- Tool exposure policy (onboarded files) ---
# Require onboarded tools to opt in explicitly with @tool(...)/TOOLS/register.
# The legacy "function name == file stem" fallback is rejected over the wire so
# a helper can't become a callable tool by filename coincidence (the trusted
# local tools dir still accepts it). Every onboard/pending record includes a
# tool_manifest previewing exactly which functions are exposed vs not.
MCP_TOOL_ONBOARD_REQUIRE_EXPLICIT=true
# Max tools a single onboarded file may expose (0 = no limit).
MCP_TOOL_ONBOARD_MAX_TOOLS=0

# ============================================================================
# Configurable per-route auth (main.py) — see docs/dev/02-security-auth.md
# Each policy is one of: none | mcp | admin
#   none  = open; mcp = the active MCP credential (api key / JWT); admin = admin token
# Admin routes (/admin/*) are ALWAYS gated by MCP_ADMIN_TOKEN (not configurable).
# The MCP protocol endpoints (/sse, /messages) always require the MCP credential.
# ============================================================================
MCP_READ_AUTH=mcp          # /status, /tools
MCP_METRICS_AUTH=mcp       # /metrics  (set 'none' to allow open Prometheus scraping)
MCP_TOOL_CALL_AUTH=mcp     # POST /tools/{name}/call  (set 'admin' to restrict execution)
MCP_UPSTREAM_AUTH=mcp      # /mcp/upstreams* (list + call remote MCP tools)

# --- Federation: remote MCP servers this server can list/call tools on ---
# Inline JSON: {"name": {"url": "http://host:8000/sse", "token": "optional-bearer"}}
# (a bare string value is shorthand for {"url": "..."}). Or point at a JSON file.
MCP_UPSTREAMS=
MCP_UPSTREAMS_FILE=
MCP_UPSTREAM_TIMEOUT_SEC=30
MCP_UPSTREAM_ALLOW_RUNTIME=true   # allow admin add/remove of upstreams at runtime
